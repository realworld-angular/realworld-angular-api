# Database
DATABASE_URL=""

# JWT
JWT_SECRET=""
JWT_EXPIRES_IN="31d"

# Cookie
COOKIE_SECRET=""

# App
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins (leave empty to reflect all origins in dev)
ALLOWED_ORIGINS=""

# Order lifecycle delays (milliseconds)
ORDER_PENDING_TO_PREPARING_MS=120000
ORDER_PREPARING_TO_READY_MS=300000
ORDER_READY_TO_DELIVERED_MS=180000
ORDER_JOB_INTERVAL_MS=30000
